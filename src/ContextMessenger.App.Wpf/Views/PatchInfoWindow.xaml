<Window x:Class="ContextMessenger.App.Wpf.Views.PatchInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ContextMessenger.App.Wpf.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:PatchReviewViewModel, IsDesignTimeCreatable=False}"
        Title="Patch Info"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,12,6"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="FieldValue" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Patch ID" Style="{StaticResource FieldLabel}"/>
            <TextBox  Grid.Row="0" Grid.Column="1" Text="{Binding PatchId, Mode=OneWay}" Style="{StaticResource FieldValue}"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Revision" Style="{StaticResource FieldLabel}"/>
            <TextBox  Grid.Row="1" Grid.Column="1" Text="{Binding Revision, Mode=OneWay}" Style="{StaticResource FieldValue}"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Status" Style="{StaticResource FieldLabel}"/>
            <TextBox  Grid.Row="2" Grid.Column="1" Text="{Binding TransactionStatus, Mode=OneWay}" Style="{StaticResource FieldValue}"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Phase" Style="{StaticResource FieldLabel}"/>
            <TextBox  Grid.Row="3" Grid.Column="1" Text="{Binding Phase, Mode=OneWay}" Style="{StaticResource FieldValue}"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Title" Style="{StaticResource FieldLabel}"/>
            <TextBox  Grid.Row="4" Grid.Column="1" Text="{Binding Title, Mode=OneWay}" Style="{StaticResource FieldValue}"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Description" Style="{StaticResource FieldLabel}"/>
            <TextBox  Grid.Row="5" Grid.Column="1" Text="{Binding Description, Mode=OneWay}"
                      Style="{StaticResource FieldValue}" MaxHeight="160" VerticalScrollBarVisibility="Auto"/>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Commit message" Style="{StaticResource FieldLabel}"/>
            <TextBox  Grid.Row="6" Grid.Column="1" Text="{Binding CommitMessage, Mode=OneWay}"
                      Style="{StaticResource FieldValue}" FontFamily="Consolas" MaxHeight="160" VerticalScrollBarVisibility="Auto"/>

            <TextBlock Grid.Row="7" Grid.Column="0" Text="Build" Style="{StaticResource FieldLabel}"/>
            <TextBox  Grid.Row="7" Grid.Column="1" Text="{Binding BuildSummary, Mode=OneWay}" Style="{StaticResource FieldValue}"/>

            <TextBlock Grid.Row="8" Grid.Column="0" Text="Build errors" Style="{StaticResource FieldLabel}"/>
            <TextBox  Grid.Row="8" Grid.Column="1" Text="{Binding BuildErrors.Count, Mode=OneWay}" Style="{StaticResource FieldValue}"/>

            <TextBlock Grid.Row="9" Grid.Column="0" Text="Build warnings" Style="{StaticResource FieldLabel}"/>
            <TextBox  Grid.Row="9" Grid.Column="1" Text="{Binding BuildWarnings.Count, Mode=OneWay}" Style="{StaticResource FieldValue}"/>

            <TextBlock Grid.Row="10" Grid.Column="0" Text="Tests" Style="{StaticResource FieldLabel}"/>
            <TextBox  Grid.Row="10" Grid.Column="1" Text="{Binding TestSummary, Mode=OneWay}" Style="{StaticResource FieldValue}"/>

            <TextBlock Grid.Row="11" Grid.Column="0" Text="Test failures" Style="{StaticResource FieldLabel}"/>
            <TextBox  Grid.Row="11" Grid.Column="1" Text="{Binding TestFailures.Count, Mode=OneWay}" Style="{StaticResource FieldValue}"/>
        </Grid>

        <Button Grid.Row="1"
                Content="Close"
                IsCancel="True"
                IsDefault="True"
                HorizontalAlignment="Right"
                MinWidth="80"
                Padding="10,4"
                Margin="0,8,0,0"
                Click="Close_OnClick"/>
    </Grid>
</Window>

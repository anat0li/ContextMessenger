<UserControl x:Class="ContextMessenger.App.Wpf.Views.DiffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit">
    <Border BorderBrush="#AEB8C2" BorderThickness="1">
        <avalonEdit:TextEditor x:Name="Editor"
                               IsReadOnly="True"
                               ShowLineNumbers="False"
                               FontFamily="Consolas, Cascadia Code, Courier New"
                               FontSize="12"
                               Padding="0"
                               VerticalScrollBarVisibility="Auto"
                               HorizontalScrollBarVisibility="Auto"
                               ContextMenuOpening="Editor_OnContextMenuOpening">
            <avalonEdit:TextEditor.ContextMenu>
            <ContextMenu>
                <MenuItem x:Name="AddCommentMenuItem" Header="Add Comment…" Click="AddComment_OnClick"/>
                <Separator/>
                <MenuItem Header="Copy" Command="ApplicationCommands.Copy"/>
            </ContextMenu>
            </avalonEdit:TextEditor.ContextMenu>
        </avalonEdit:TextEditor>
    </Border>
</UserControl>

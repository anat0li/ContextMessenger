<Window x:Class="ContextMessenger.App.Wpf.Views.AddCommentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Comment"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   x:Name="PromptText"
                   FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis"
                   Margin="0,0,0,8"/>

        <TextBox Grid.Row="1"
                 x:Name="CommentBox"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MinHeight="100"
                 VerticalScrollBarVisibility="Auto"
                 SpellCheck.IsEnabled="True"/>

        <CheckBox Grid.Row="2"
                  x:Name="OptionCheckBox"
                  Margin="0,10,0,0"
                  Visibility="Collapsed"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Add" IsDefault="True" MinWidth="80" Padding="10,4" Click="Ok_OnClick"/>
            <Button Content="Cancel" IsCancel="True" MinWidth="80" Padding="10,4" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
